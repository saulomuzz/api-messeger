# ── Desenvolvimento — modo teste sempre ligado ──────────
# Todo envio é redirecionado para DEV_TEST_PHONE, nunca sai pro destinatário real.
DEV_MODE_ENABLED=true
DEV_TEST_PHONE=

PORT=3000
SQLITE_PATH=/app/data/app.sqlite
CORS_ORIGIN=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_SESSION_HOURS=24

# Pode reaproveitar as credenciais reais da Meta (DEV_MODE_ENABLED já impede
# envio pro destinatário real) ou, se disponível, usar um phone_number_id de
# teste separado na Meta para não competir com o rate limit/qualidade do número real.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_DOMAIN=

ABUSEIPDB_API_KEY=
GLOBAL_IP_ALLOWLIST=
SECURITY_YELLOW_THRESHOLD=25
SECURITY_BLOCK_THRESHOLD=75
SECURITY_REPUTATION_TTL_MINUTES=1440
SECURITY_GLOBAL_RATE_LIMIT_PER_MINUTE=120
